# Server environment configuration
# Copy this file to .env and fill in the values

# Server
NODE_ENV=development
PORT=5000

# MongoDB connection string (local or Atlas)
# Local: mongodb://127.0.0.1:27017/learnchinese
# Atlas: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/learnchinese
MONGODB_URI=mongodb://127.0.0.1:27017/learnchinese

# JWT secret - use a strong random string in production
JWT_SECRET=change_this_to_a_long_random_string_in_production
JWT_EXPIRES_IN=7d

# Admin seed account (created on first run via seed script)
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@learnchinese.app
ADMIN_PASSWORD=admin123456

# CORS allowed origins (comma separated)
CLIENT_URL=http://localhost:5173

# 支付模式
# dev = 模拟支付（本地测试）
# production = 真实/二维码收款模式：支付宝/微信商户配置后会自动走真实接口；未配置则展示个人收款码
PAYMENT_MODE=dev
PAYMENT_PROVIDER=alipay

# 支付宝商户配置（可选）
# 不填则使用 client/public/qr/alipay.jpg 个人收款码
ALIPAY_APP_ID=
ALIPAY_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=
ALIPAY_NOTIFY_URL=http://localhost:5000/api/payments/notify/alipay
ALIPAY_RETURN_URL=http://localhost:5173/account

# 微信商户配置（可选）
# 不填则使用 client/public/qr/wechat.jpg 个人收款码
WECHAT_APPID=
WECHAT_MCHID=
WECHAT_API_V3_KEY=
WECHAT_SERIAL_NO=
WECHAT_PRIVATE_KEY_PATH=
WECHAT_NOTIFY_URL=http://localhost:5000/api/payments/notify/wechat

# Stripe / PayPal（可选）
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox
