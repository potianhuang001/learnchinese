# Client environment configuration
# Copy this file to .env.local for local development, or configure on the hosting platform
# Vite only exposes variables prefixed with VITE_ to the browser

# Backend API base URL.
# - Local development: leave empty (defaults to /api, proxied by Vite to http://localhost:5000)
# - Production: set to the deployed backend URL, e.g. https://learnchinese-api.onrender.com
VITE_API_URL=
